# Copy this file to .env.local for local development, and add the same
# values in Vercel under Project → Settings → Environment Variables.
# Leave the Supabase values empty to run the app in demo mode.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only (never prefix with VITE_): used by the nightly scoring job.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; Vercel sends it with cron requests.
CRON_SECRET=
